 "is_standard": 1,
 "message": "<!DOCTYPE html>\n<html lang=\"fr\" xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n<meta name=\"x-apple-disable-message-reformatting\">\n<title>Nouveau pr\u00e9-audit \u2014 {{ doc.company_name }}</title>\n<!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]-->\n<style>\n  body, table, td, p, a, li, blockquote { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }\n  table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }\n  img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }\n  body { margin: 0; padding: 0; width: 100% !important; }\n  #outlook a { padding: 0; }\n  .ReadMsgBody { width: 100%; }\n  .ExternalClass { width: 100%; }\n  .ExternalClass, .ExternalClass p, .ExternalClass td, .ExternalClass div, .ExternalClass span, .ExternalClass font { line-height: 100%; }\n</style>\n</head>\n<body style=\"margin:0;padding:0;background-color:#f4f7ff;font-family:Montserrat,-apple-system,Segoe UI,Helvetica,Arial,sans-serif;\">\n\n  {%- set answers = answers or [] -%}\n  {%- set total = answers | length or 15 -%}\n  {%- set submission_date = submission_date or doc.creation -%}\n\n  {%- set oui_count = answers | selectattr(\"response\", \"equalto\", \"Oui\") | list | length -%}\n  {%- set non_count = answers | selectattr(\"response\", \"equalto\", \"Non\") | list | length -%}\n  {%- set nsp_count = answers | selectattr(\"response\", \"equalto\", \"NSP\") | list | length -%}\n\n  {%- set oui_rate = (oui_count / total * 100) | round(0) | int -%}\n\n<!--[if mso]><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"640\" align=\"center\"><tr><td><![endif]-->\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" width=\"100%\" style=\"max-width:600px;background-color:#f4f7ff;\">\n<tr><td style=\"padding:32px 20px;\">\n\n  <!-- Logo -->\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" width=\"100%\"><tr>\n    <td style=\"text-align:center;padding-bottom:24px;\">\n      <a href=\"{{ frappe.utils.get_url() }}/\" target=\"_blank\" style=\"text-decoration:none;display:inline-block;\">\n        <img src=\"{{ frappe.utils.get_url() }}/assets/amoamancustom/images/logo.webp\"\n             alt=\"Amoaman &amp; Associ\u00e9s\" height=\"32\"\n             style=\"height:32px;width:auto;border:0;display:block;\">\n      </a>\n    </td>\n  </tr></table>\n\n  <!-- Card -->\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" width=\"100%\" style=\"background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 8px 32px rgba(8,26,42,.08);\">\n\n    <!-- Hero -->\n    <tr>\n      <td style=\"background:linear-gradient(135deg,#266BCC 0%,#1a4f9e 100%);padding:32px 36px;text-align:center;\">\n        <span style=\"display:inline-block;background:rgba(255,255,255,.18);color:#ffffff;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;border-radius:99px;padding:4px 14px;margin-bottom:14px;\">\n          Pr\u00e9-audit &bull; Loi 2013-450\n        </span>\n        <h1 style=\"margin:0 0 8px;font-size:22px;font-weight:800;color:#ffffff;line-height:1.3;\">\n          Nouveau questionnaire soumis\n        </h1>\n        <p style=\"margin:0;font-size:14px;color:rgba(255,255,255,.82);line-height:1.6;\">\n          <strong style=\"color:#ffffff;\">{{ doc.company_name }}</strong> a compl\u00e9t\u00e9 le pr\u00e9-audit de conformit\u00e9.\n        </p>\n      </td>\n    </tr>\n\n    <!-- R\u00e9f + Date + Statut -->\n    <tr>\n      <td style=\"padding:24px 36px 0;\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\"><tr>\n\n          <td style=\"vertical-align:top;padding-right:12px;\">\n            <p style=\"margin:0 0 2px;font-size:11px;font-weight:600;color:#6b7280;text-transform:uppercase;letter-spacing:.5px;\">R\u00e9f\u00e9rence</p>\n            <p style=\"margin:0;font-size:15px;font-weight:700;color:#081A2A;\">{{ doc.name }}</p>\n          </td>\n\n          <td style=\"vertical-align:top;padding:0 12px;\">\n            <p style=\"margin:0 0 2px;font-size:11px;font-weight:600;color:#6b7280;text-transform:uppercase;letter-spacing:.5px;\">Date</p>\n            <p style=\"margin:0;font-size:15px;font-weight:700;color:#081A2A;\">\n              {{ frappe.utils.format_date(submission_date, \"dd MMMM yyyy\") }}\n            </p>\n            <p style=\"margin:2px 0 0;font-size:12px;color:#6b7280;\">\n              {{ frappe.utils.format_datetime(submission_date, \"HH:mm\") }}\n            </p>\n          </td>\n\n          <td style=\"vertical-align:top;padding-left:12px;text-align:right;\">\n            <p style=\"margin:0 0 2px;font-size:11px;font-weight:600;color:#6b7280;text-transform:uppercase;letter-spacing:.5px;\">Statut</p>\n            <span style=\"display:inline-block;background:#eef2ff;color:#266BCC;font-size:13px;font-weight:700;border-radius:99px;padding:4px 14px;\">\n              {{ doc.status }}\n            </span>\n          </td>\n\n        </tr></table>\n      </td>\n    </tr>\n\n    <!-- Score r\u00e9sum\u00e9 -->\n    <tr>\n      <td style=\"padding:24px 36px 0;\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"background:#f8f9ff;border-radius:12px;\">\n\n          <tr>\n            <td style=\"padding:20px 24px 16px;\" colspan=\"3\">\n              <p style=\"margin:0;font-size:13px;font-weight:700;color:#081A2A;text-transform:uppercase;letter-spacing:.5px;\">\n                Score de conformit\u00e9\n              </p>\n            </td>\n          </tr>\n\n          <tr>\n            <td style=\"padding:0 0 20px 24px;width:33%;vertical-align:top;\">\n              <p style=\"margin:0 0 4px;font-size:28px;font-weight:800;color:#16a34a;line-height:1;\">\n                {{ oui_count }}<span style=\"font-size:16px;font-weight:600;\">/{{ total }}</span>\n              </p>\n              <p style=\"margin:0;font-size:12px;font-weight:600;color:#15803d;\">\n                <span style=\"display:inline-block;width:8px;height:8px;border-radius:50%;background:#16a34a;margin-right:5px;\"></span>\n                Conformit\u00e9\n              </p>\n            </td>\n            <td style=\"padding:0 0 20px 0;width:33%;vertical-align:top;\">\n              <p style=\"margin:0 0 4px;font-size:28px;font-weight:800;color:#dc2626;line-height:1;\">\n                {{ non_count }}<span style=\"font-size:16px;font-weight:600;\">/{{ total }}</span>\n              </p>\n              <p style=\"margin:0;font-size:12px;font-weight:600;color:#b91c1c;\">\n                <span style=\"display:inline-block;width:8px;height:8px;border-radius:50%;background:#dc2626;margin-right:5px;\"></span>\n                Non-conformit\u00e9\n              </p>\n            </td>\n            <td style=\"padding:0 24px 20px 0;width:33%;vertical-align:top;\">\n              <p style=\"margin:0 0 4px;font-size:28px;font-weight:800;color:#9333ea;line-height:1;\">\n                {{ nsp_count }}<span style=\"font-size:16px;font-weight:600;\">/{{ total }}</span>\n              </p>\n              <p style=\"margin:0;font-size:12px;font-weight:600;color:#7c3aed;\">\n                <span style=\"display:inline-block;width:8px;height:8px;border-radius:50%;background:#9333ea;margin-right:5px;\"></span>\n                Incertain\n              </p>\n            </td>\n          </tr>\n\n          <!-- Barre -->\n          <tr>\n            <td style=\"padding:0 24px 8px;\" colspan=\"3\">\n              <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\">\n                <tr>\n                  {%- set oui_pct = (oui_count / total * 100) | round(0, 'floor') | int -%}\n                  {%- set non_pct = (non_count / total * 100) | round(0, 'floor') | int -%}\n                  {%- set nsp_pct = 100 - oui_pct - non_pct -%}\n                  {% if oui_pct > 0 %}<td style=\"background:#16a34a;height:8px;border-radius:4px 0 0 4px;width:{{ oui_pct }}%;\"></td>{% endif %}\n                  {% if non_pct > 0 %}<td style=\"background:#dc2626;height:8px;width:{{ non_pct }}%;\"></td>{% endif %}\n                  {% if nsp_pct > 0 %}<td style=\"background:#9333ea;height:8px;border-radius:0 4px 4px 0;width:{{ nsp_pct }}%;\"></td>{% endif %}\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Taux + Verdict -->\n          <tr>\n            <td style=\"padding:8px 24px 20px;\" colspan=\"3\">\n              <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\"><tr>\n                <td>\n                  <p style=\"margin:0;font-size:20px;font-weight:800;color:#081A2A;\">\n                    {{ oui_rate }}%<span style=\"font-size:12px;font-weight:500;color:#6b7280;margin-left:4px;\">de conformit\u00e9</span>\n                  </p>\n                </td>\n                <td style=\"text-align:right;\">\n                {% if oui_rate >= 70 %}\n                  <span style=\"display:inline-block;background:#ecfdf5;color:#15803d;font-size:13px;font-weight:700;border-radius:99px;padding:5px 14px;border:1px solid #bbf7d0;\">\n                    Profil favorable\n                  </span>\n                {% elif oui_rate >= 40 %}\n                  <span style=\"display:inline-block;background:#fef9c3;color:#a16207;font-size:13px;font-weight:700;border-radius:99px;padding:5px 14px;border:1px solid #fde047;\">\n                    Risque mod\u00e9r\u00e9\n                  </span>\n                {% else %}\n                  <span style=\"display:inline-block;background:#fef2f2;color:#dc2626;font-size:13px;font-weight:700;border-radius:99px;padding:5px 14px;border:1px solid #fecaca;\">\n                    Risque \u00e9lev\u00e9\n                  </span>\n                {% endif %}\n                </td>\n              </tr></table>\n            </td>\n          </tr>\n\n        </table>\n      </td>\n    </tr>\n\n    <!-- Infos entreprise (light) -->\n    <tr>\n      <td style=\"padding:24px 36px 0;\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"background:#f8f9ff;border-radius:12px;\">\n\n          <tr>\n            <td style=\"padding:16px 24px 0;\" colspan=\"6\">\n              <p style=\"margin:0;font-size:13px;font-weight:700;color:#081A2A;text-transform:uppercase;letter-spacing:.5px;\">\n                Informations contact\n              </p>\n            </td>\n          </tr>\n\n          <tr>\n            <td style=\"padding:14px 24px 0;width:50%;font-size:11px;font-weight:600;color:#6b7280;text-transform:uppercase;letter-spacing:.5px;\">\n              Contact\n            </td>\n            <td style=\"padding:14px 24px 0;width:50%;font-size:11px;font-weight:600;color:#6b7280;text-transform:uppercase;letter-spacing:.5px;\">\n              Email\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:4px 24px 14px;font-size:14px;font-weight:600;color:#081A2A;\">\n              {{ doc.contact_person }}{% if doc.role %}, {{ doc.role }}{% endif %}\n            </td>\n            <td style=\"padding:4px 24px 14px;font-size:14px;font-weight:600;\">\n              <a href=\"mailto:{{ doc.email }}\" target=\"_blank\" style=\"color:#266BCC;text-decoration:none;\">{{ doc.email }}</a>\n            </td>\n          </tr>\n\n        </table>\n      </td>\n    </tr>\n\n    <!-- CTA -->\n    <tr>\n      <td style=\"padding:28px 36px 36px;text-align:center;\">\n        <!--[if mso]><v:roundrect xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:w=\"urn:schemas-microsoft-com:office:word\" href=\"{{ frappe.utils.get_url() }}/app/data-compliance-pre-audit/{{ doc.name }}\" style=\"height:48px;v-text-anchor:middle;\" arcsize=\"50%\" strokecolor=\"#266BCC\" fillcolor=\"#266BCC\"><w:anchorlock/><center style=\"color:#ffffff;font-family:Montserrat,-apple-system,Segoe UI,Helvetica,Arial,sans-serif;font-size:14px;font-weight:700;\"><![endif]-->\n        <a href=\"{{ frappe.utils.get_url() }}/app/data-compliance-pre-audit/{{ doc.name }}\" target=\"_blank\"\n           style=\"display:inline-block;background:linear-gradient(135deg,#266BCC 0%,#1a4f9e 100%);color:#ffffff;font-family:Montserrat,-apple-system,Segoe UI,Helvetica,Arial,sans-serif;font-size:14px;font-weight:700;text-decoration:none;border-radius:99px;padding:14px 36px;box-shadow:0 4px 14px rgba(38,107,204,.35);\">\n          Voir le dossier complet &rarr;\n        </a>\n        <!--[if mso]></center></v:roundrect><![endif]-->\n      </td>\n    </tr>\n\n    <!-- Footer -->\n    <tr>\n      <td style=\"padding:0 36px 28px;text-align:center;border-top:1px solid #eef1f8;\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\"><tr>\n          <td style=\"padding-top:18px;\">\n            <p style=\"margin:0 0 6px;font-size:11px;color:#6b7280;line-height:1.7;\">\n              Notification automatique \u2014 le rapport sera envoy\u00e9 au client sous 24 \u00e0 48h ouvrables apr\u00e8s analyse.\n            </p>\n            <p style=\"margin:0;font-size:11px;font-weight:600;color:#081A2A;\">\n              Amoaman &amp; Associ\u00e9s\n            </p>\n            <p style=\"margin:4px 0 0;font-size:11px;color:#6b7280;\">\n              <a href=\"https://amoaman.ci\" target=\"_blank\" style=\"color:#266BCC;text-decoration:none;\">amoaman.ci</a>\n              &nbsp;&bull;&nbsp;\n              <a href=\"mailto:contact@amoaman.ci\" style=\"color:#266BCC;text-decoration:none;\">contact@amoaman.ci</a>\n            </p>\n          </td>\n        </tr></table>\n      </td>\n    </tr>\n\n  </table>\n\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" width=\"100%\"><tr>\n    <td style=\"padding-top:16px;text-align:center;font-size:11px;color:#94a3b8;\">\n      Vous recevez cet email en tant qu'administrateur de la plateforme.\n    </td>\n  </tr></table>\n\n</td></tr>\n</table>\n<!--[if mso]></td></tr></table><![endif]-->\n\n</body>\n</html>",
